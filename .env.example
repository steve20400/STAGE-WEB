VITE_APP_BASE_PATH=/
# Backend Next.js. Valeur par defaut du code si la variable est absente :
# https://alanyavox.com (le VPS de production). Pour un backend local :
#   VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=https://alanyavox.com
# Serveur WebSocket. Deduit de VITE_API_BASE_URL si absent :
#   host distant  -> wss://<host>/ws  (Nginx proxifie /ws vers le port 3001)
#   localhost     -> ws://localhost:3001
VITE_WS_URL=wss://alanyavox.com/ws
VITE_DATA_MODE=auto

# Configuration Firebase Client (FCM Web Push)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_VAPID_KEY=YOUR_FIREBASE_VAPID_KEY

# TURN (appels entre reseaux differents).
# Le serveur par defaut du projet (open.alanya.cloud) est code en dur dans
# src/services/calls-service.ts : aucune variable n'est requise pour que les
# appels fonctionnent. Definir VITE_TURN_* permet seulement de surcharger avec
# un autre fournisseur (tests, comparaison) :
# VITE_TURN_URLS=turns:open.alanya.cloud:443?transport=tcp
# VITE_TURN_USERNAME=...
# VITE_TURN_CREDENTIAL=...
