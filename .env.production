# URLs de production embarquees au build (Vercel, Netlify, etc.)
# Ce sont des URLs publiques : aucun secret ici.
# Le VPS alanyavox.com sert l'API Next.js ET le serveur temps reel (Nginx
# proxifie /ws vers le process alanya-ws). Les anciens deploiements
# (backend-alanya.vercel.app, alanya-ws.d-bria00.workers.dev) ne sont plus
# utilises : le worker WebSocket ne repond plus.
VITE_API_BASE_URL=https://alanyavox.com
VITE_WS_URL=wss://alanyavox.com/ws
VITE_DATA_MODE=api

# Configuration Firebase Client (FCM Web Push)
VITE_FIREBASE_API_KEY=AIzaSyB-dy4SK9WJQjEAeKZzRnGx6MtWUAQlwII
VITE_FIREBASE_AUTH_DOMAIN=alanya00.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=alanya00
VITE_FIREBASE_MESSAGING_SENDER_ID=854184379004
VITE_FIREBASE_APP_ID=1:854184379004:web:edfd39f781fbdd15323ff9
VITE_FIREBASE_VAPID_KEY=VOTRE_CLÉ_VAPID_DEPUIS_FIREBASE

# Le relais TURN (appels entre reseaux differents) se configure dans les
# variables d'environnement Vercel du projet (pas ici, le repo est public) :
#   VITE_TURN_URLS, VITE_TURN_USERNAME, VITE_TURN_CREDENTIAL
# Voir .env.example pour le format.
