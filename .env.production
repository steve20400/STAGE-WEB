VITE_APP_BASE_PATH=/
# URLs de production embarquees au build (Vercel, Netlify, etc.)
# Ce sont des URLs publiques : aucun secret ici.
# Le VPS alanyavox.com sert l'API Next.js ET le serveur temps reel (Nginx
# proxifie /ws vers le process alanya-ws). Les anciens deploiements
# (backend-alanya.vercel.app, alanya-ws.d-bria00.workers.dev) ne sont plus
# utilises : le worker WebSocket ne repond plus.
VITE_API_BASE_URL=https://alanyavox.com
VITE_WS_URL=wss://alanyavox.com/ws
VITE_DATA_MODE=api

